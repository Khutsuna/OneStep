@startuml c4-2-containers.ka
!include <C4/C4_Container>
!include onestep-theme.ka.puml
' Georgian version of c4-2-containers.puml, for the Georgian presentation.

title Technica — დონე 2: კონტეინერები\n<size:12>ცალკე გაშვებული ნაწილები და როგორ უკავშირდებიან ერთმანეთს</size>

Person(customer, "მომხმარებელი")
Person(staff, "მენეჯერი / ადმინისტრატორი")

System_Boundary(onestep, "Technica") {
  Container(spa, "ერთგვერდიანი აპლიკაცია (SPA)", "Angular 22, TypeScript, Angular Material, NgRx Signal Store", "მაღაზია, კალათა და შეკვეთის გაფორმება, მომხმარებლის ანგარიში და ადმინის პანელი. მუშაობს ბრაუზერში")
  Container(api, "Web API", "ASP.NET Core 10, C#", "REST/JSON API: ბიზნეს წესები, JWT ავტორიზაცია და როლები, ვალიდაცია, Swagger დოკუმენტაცია, შეცდომების დამუშავება და ლოგირება")
  ContainerDb(db, "მონაცემთა ბაზა", "Microsoft SQL Server 2025", "23 ცხრილი (EF Core მიგრაციები) და ხელით დაწერილი SQL: კატალოგის view, ანალიტიკის პროცედურები, ფასის ისტორიის ტრიგერი, საწყისი მონაცემები", $tags="db")
  Container(files, "სურათების საცავი", "საქაღალდე wwwroot/uploads", "პროდუქტების ფოტოები, ბრაუზერს სტატიკურ ფაილებად მიეწოდება")
  Container(logs, "ლოგ ფაილები", "Serilog", "ერთი ფაილი დღეში: მოთხოვნები, გაფრთხილებები და შეცდომები")
}

Rel_Down(customer, spa, "იყენებს", "HTTPS")
Rel_Down(staff, spa, "იყენებს", "HTTPS")
Rel_Down(spa, api, "იძახებს", "JSON / HTTPS, JWT ტოკენი")
Rel_Down(api, db, "კითხულობს და წერს", "EF Core / SQL")
Rel_Right(api, files, "ინახავს და აწვდის ფოტოებს")
Rel_Left(api, logs, "წერს")

SHOW_LEGEND()
@enduml
